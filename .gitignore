# ---------------------------------------------------------------------------
# Generated tilesets
# ---------------------------------------------------------------------------
# vox3dt writes tileset.json + content/*.glb + report.json into whatever -o
# points at. These are build artifacts: regenerate them from the LAS instead of
# committing them (a single small site is already ~45 MB, and gzip sidecars
# double the file count).
out/
output/
tiles/
tileset/
dist/

# Catch a tileset written to an unusual directory name.
**/content/*.glb
**/content/*.glb.gz
**/tileset.json
**/tileset.json.gz
report.json

# ---------------------------------------------------------------------------
# Point clouds and other large inputs
# ---------------------------------------------------------------------------
# Source data lives wherever it lives -- never in the repo. LAS/LAZ files are
# routinely gigabytes.
*.las
*.laz
*.copc
*.copc.laz
*.e57
*.ply
*.pcd
inputdata/
input/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/

# Environments
.venv/
venv/
ENV/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
uv.lock

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
# JetBrains (IntelliJ, PyCharm, CLion, ...)
.idea/
*.iml
*.iws
*.ipr
out/          # also an IntelliJ build dir, hence listed twice on purpose
cmake-build-*/

# VS Code -- ignore local state, but let a team share deliberate config by
# force-adding it (`git add -f .vscode/extensions.json`).
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace
.history/

# Vim / Emacs / Sublime / others
*.swp
*.swo
*.swn
*~
\#*\#
.\#*
*.sublime-project
*.sublime-workspace
.spyproject/
.spyderproject/
.ropeproject/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.fuse_hidden*
.nfs*

# ---------------------------------------------------------------------------
# Logs, temp files, secrets
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
